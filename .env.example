AZURE_OPENAI_API_KEY=replace_with_rotated_key
AZURE_AGENT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project/agents/your-agent/endpoint/protocols/openai
AZURE_AGENT_NAME=trippy-research-agent
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_DEPLOYMENT_LUNA=your-deployment-name
AZURE_DEPLOYMENT_SOL=your-deployment-name
TRIPPY_BRIDGE_TOKEN=generate_a_long_random_token

# Stage 0: public project address; never put privileged credentials in the iOS app.
SUPABASE_URL=https://zsecfyracbhhvxvzgvfw.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use an anon key instead of a publishable key.
SUPABASE_ANON_KEY=
# Backend runtime pooler connection; obtain the exact URL from Connect in Supabase.
DATABASE_URL=
# Direct or session-pooler connection for migrations; do not guess the hostname.
MIGRATION_DATABASE_URL=
# Optional, only for explicitly scoped privileged backend operations.
SUPABASE_SECRET_KEY=

# New backend defaults: offline execution, no automatic paid provider calls.
TRIPPY_ENVIRONMENT=local
TRIPPY_ALLOW_PAID_RESEARCH=false
# Set only after agreeing a measured provider budget and currency.
TRIPPY_AI_BUDGET_AMOUNT=
TRIPPY_AI_BUDGET_CURRENCY=
# Deployment rates per million tokens, in the budget currency above.
# Required only by the explicit Luna transcript extractor; no estimated defaults.
TRIPPY_LUNA_INPUT_PER_MILLION=
TRIPPY_LUNA_OUTPUT_PER_MILLION=
TRIPPY_DB_POOL_SIZE=3
TRIPPY_WORKER_CONCURRENCY=1

# Stage 2: separate versioned backend. Defaults to local SQLite + fake worker.
# Remote runtime opt-in does not apply migrations or enable paid inference.
TRIPPY_BACKEND_CONNECTED=false
# Catalog decision: Barcelona target 500 enriched places, Luna only.
# SOL remains a legacy provider field above; no automatic Sol fallback is used.

# Optional official YouTube discovery. Quota-limited, no paid fallback or media download.
# Keep restricted API credentials on the backend; CLI safely reads .env with shell precedence.
YOUTUBE_API_KEY=

# Complete trip pipeline: the web agent and Luna share the existing global ledger.
# This is a conservative per-web-request reservation, not an invoice rate.
# No provider initializes unless paid research and all budgets/rates are configured.
TRIPPY_WEB_RESERVATION_PER_CALL=
TRIPPY_SHARED_BUDGET_LEDGER=.local/stage3/extraction-budget.sqlite
